{
  "expo": {
    "name": "RuhChat",
    "slug": "ruhchat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "in.ruhvi.chat",
      "adaptiveIcon": {
        "backgroundColor": "#0A2F25",
