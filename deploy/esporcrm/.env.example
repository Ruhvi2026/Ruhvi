# ── EspoCRM Deployment (native: nginx + php-fpm + MariaDB) ────────────────
# This template documents the env values the Ruhvi extension needs. The values
# are NOT read directly from this file by EspoCRM. On a native install they are
# written into custom/Espo/ruhvi-config.php by ./install-native.sh, and the
# same values must exist in the Vercel project env for the Next.js app.
#
# On the old docker-compose stack these were passed to the containers via the
# `environment:` block. The compose stack is deprecated — use install-native.sh.

# Public host of the EspoCRM instance.
ESPO_DOMAIN=crm.support.ruhvi.in

# ── MariaDB (native install: use your existing DB creds instead) ──────────
MYSQL_DATABASE=esporcrm
MYSQL_USER=esporcrm
MYSQL_PASSWORD=change_me_db_password

# ── Shared secrets (MUST match the Vercel project env) ────────────────────
# API key for the EspoCRM REST API. Generate from Admin → API Credentials in
# EspoCRM, then set it both in the Ruhvi Vercel env (ESPO_API_KEY) and on the
# VPS (custom/Espo/ruhvi-config.php, or env var ESPO_API_KEY).
ESPO_API_KEY=generate_this_in_esporcrm_admin

# Shared secret for webhook HMAC signing between Ruhvi and EspoCRM.
# Must match the ESPO_WEBHOOK_SECRET in the Ruhvi Vercel project env.
ESPO_WEBHOOK_SECRET=change_me_webhook_secret

# Base URL of the Ruhvi Next.js app (used by the EspoCRM extension to call back).
RUHVI_BASE_URL=https://support.ruhvi.in

# Internal EspoCRM secret (cookie encryption etc.) — native install: leave as
# set during web installer; not used by the Ruhvi extension.
ESPO_SECRET=change_me_espo_secret
