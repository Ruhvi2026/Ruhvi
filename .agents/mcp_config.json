{
  "mcpServers": {
    "sentry": {
      "command": "npx",
      "args": [
        "-y",
        "@sentry/mcp-server"
      ],
      "env": {
        "SENTRY_AUTH_TOKEN": "<REPLACE_WITH_SENTRY_AUTH_TOKEN>",
        "SENTRY_URL": "https://de.sentry.io",
        "SENTRY_ORG": "ruhvi-jewels"
      }
    },
    "gsd": {
      "command": "npx",
      "args": [
        "-y",
        "-p",
        "@opengsd/gsd-core",
        "gsd-mcp-server"
      ]
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "headers": {
        "Authorization": "Bearer <REPLACE_WITH_CLOUDFLARE_API_TOKEN>"
      }
    }
  }
}
